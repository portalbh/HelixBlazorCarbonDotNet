<div class="cb-theme-toggle" role="group" aria-label="@Label">
    @foreach (var theme in Themes)
    {
        <button type="button"
                class="cb-icon-btn cb-theme-toggle__btn"
                data-cb-theme-value="@theme.Value"
                aria-label="@theme.Label"
                aria-pressed="false"
                title="@theme.Label">
            <span class="cb-theme-toggle__swatch cb-theme-toggle__swatch--@theme.Swatch" aria-hidden="true"></span>
        </button>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Theme";

    private static readonly (string Value, string Label, string Swatch)[] Themes =
    [
        (nameof(CbTheme.White), "White theme", "white"),
        (nameof(CbTheme.G10), "Gray 10 theme", "g10"),
        (nameof(CbTheme.G90), "Gray 90 theme", "g90"),
        (nameof(CbTheme.G100), "Gray 100 theme", "g100")
    ];
}
