<button type="button"
        class="cb-icon-btn cb-theme-toggle__cycle"
        data-cb-theme-cycle
        aria-label="@Label"
        title="Switch theme">
    @foreach (var theme in Themes)
    {
        <span class="cb-theme-toggle__icon@(theme.Value == nameof(CbTheme.G100) ? " cb-theme-toggle__icon--active" : "")"
              data-cb-theme-icon="@theme.Value"
              aria-hidden="true">
            <CbIcon Name="@theme.Icon" />
        </span>
    }
</button>

@code {
    [Parameter] public string Label { get; set; } = "Switch theme";

    private static readonly (string Value, CbIconName Icon, string Label)[] Themes =
    [
        (nameof(CbTheme.White), CbIconName.Light, "White theme"),
        (nameof(CbTheme.G10), CbIconName.Cloud, "Gray 10 theme"),
        (nameof(CbTheme.G90), CbIconName.Contrast, "Gray 90 theme"),
        (nameof(CbTheme.G100), CbIconName.Asleep, "Gray 100 theme")
    ];
}
