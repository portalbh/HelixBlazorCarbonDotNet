<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>PortalBH.HelixCarbon.SaaS</PackageId>
    <Title>HelixCarbon T3-Style SaaS</Title>
    <Description>Modern T3-inspired Blazor WebAssembly SaaS starter with Carbon Design, Dapper, Minimal APIs, Multi-Tenancy, and ApexCharts</Description>
    <PackageVersion>1.0.4</PackageVersion>
    <Authors>Portal.bh</Authors>
    <PackageTags>dotnet-new;templates;blazor;saas</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>false</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\*" />
    <Content Include="**\*"
             Exclude="artifacts/**;build/**;build\**;**\_ref\**;**\_carbon_tmp\**;**\bin\**;**\obj\**;**\.vs\**;**\*.nupkg;HelixCarbon.TemplatePack.csproj" />
  </ItemGroup>

</Project>
