@inherits LayoutComponentBase
@inject IConfiguration Configuration

<CbThemeProvider Theme="CbTheme.G100" Class="helix-shell">
    <CbHeader MenuLabel="Menu" MenuControls="helix-side-nav">
        <NameContent>
            <HelixWorkspaceTitle />
        </NameContent>
        <Actions>
            <div class="helix-header-actions">
                <CbThemeSwitcher />
                @if (ProfileMenuType is not null)
                {
                    <DynamicComponent Type="ProfileMenuType" />
                }
            </div>
        </Actions>
    </CbHeader>
    <CbSideNav id="helix-side-nav">
        <CbSideNavLink Href="/" Match="NavLinkMatch.All" IconName="CbIconName.Home">Home</CbSideNavLink>
        <CbSideNavLink Href="/dashboard" IconName="CbIconName.Dashboard">Dashboard</CbSideNavLink>
        <CbSideNavLink Href="/products" IconName="CbIconName.DocumentBlank">Products</CbSideNavLink>
        <CbSideNavLink Href="/tenants" IconName="CbIconName.User">Tenants</CbSideNavLink>
        <CbSideNavLink Href="/onboarding" IconName="CbIconName.Add">Onboarding</CbSideNavLink>
        @if (SideNavAuthType is not null)
        {
            <DynamicComponent Type="SideNavAuthType" />
        }
    </CbSideNav>
    <CbContent>
        @if (ShowTenantBanner)
        {
            <div class="helix-dev-banner">Tenant header: X-Tenant = @TenantSlug (subdomain also supported)</div>
        }
        @Body
    </CbContent>
</CbThemeProvider>

@code {
    private static readonly Type? ProfileMenuType =
        ResolveLayoutComponentType("HelixProfileMenuBff", "HelixProfileMenuAzure");

    private static readonly Type? SideNavAuthType =
        ResolveLayoutComponentType("HelixSideNavAuthBff", "HelixSideNavAuthAzure");

    private string TenantSlug => Configuration["App:DefaultTenantSlug"] ?? "demo";

    private bool ShowTenantBanner => Configuration.GetValue("App:ShowTenantBanner", false);

    private static Type? ResolveLayoutComponentType(params string[] componentNames)
    {
        var layoutNamespace = typeof(MainLayout).Namespace;
        if (string.IsNullOrWhiteSpace(layoutNamespace))
        {
            return null;
        }

        foreach (var componentName in componentNames)
        {
            var componentType = typeof(MainLayout).Assembly.GetType($"{layoutNamespace}.{componentName}");
            if (componentType is not null)
            {
                return componentType;
            }
        }

        return null;
    }
}
