@page "/dashboard"
@inject IConfiguration Configuration

<PageTitle>Dashboard</PageTitle>

<header class="cb-page-header">
    <div class="cb-page-header__body">
        <h1 class="cb-page-header__title">Tenant dashboard</h1>
        <p class="cb-page-header__description">Revenue and product metrics for @WorkspaceLabel.</p>
    </div>
</header>

<DashboardMetricsPanel />

@code {
    private string WorkspaceLabel
    {
        get
        {
            var slug = Configuration["App:DefaultTenantSlug"] ?? "demo";
            return string.IsNullOrWhiteSpace(slug)
                ? "the active workspace"
                : $"workspace {slug}";
        }
    }
}
