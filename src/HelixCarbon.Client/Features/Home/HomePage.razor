@page "/"
@inject IConfiguration Configuration

<PageTitle>@WorkspaceTitle</PageTitle>

<header class="cb-page-header">
    <div class="cb-page-header__body">
        <h1 class="cb-page-header__title">@WorkspaceTitle</h1>
        <p class="cb-page-header__description">Multi-tenant workspace with Carbon Design, Dapper, and ApexCharts.</p>
    </div>
</header>

<CbTile>
    <p><strong>Quick start</strong></p>
    <ul>
        <li>Set tenant via subdomain (<code>demo.localhost</code>) or <code>X-Tenant: demo</code></li>
        <li>Visit <CbLink Href="/dashboard">Dashboard</CbLink> for tenant metrics</li>
        <li>Manage <CbLink Href="/products">Products</CbLink> (tenant-isolated CRUD)</li>
        <li>Create workspaces on <CbLink Href="/onboarding">Onboarding</CbLink></li>
    </ul>
</CbTile>

@code {
    private string WorkspaceTitle
    {
        get
        {
            var slug = Configuration["App:DefaultTenantSlug"] ?? "demo";
            return string.IsNullOrWhiteSpace(slug)
                ? "Workspace"
                : char.ToUpperInvariant(slug[0]) + slug[1..];
        }
    }
}
