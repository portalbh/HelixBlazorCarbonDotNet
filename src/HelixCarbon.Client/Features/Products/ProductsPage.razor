@page "/products"
@rendermode InteractiveWebAssembly
@inject HelixApiClient Api

<PageTitle>Products</PageTitle>

<header class="cb-page-header">
    <div class="cb-page-header__body">
        <h1 class="cb-page-header__title">Products</h1>
        <p class="cb-page-header__description">Manage tenant-scoped products for the current workspace.</p>
    </div>
</header>

<section class="helix-section helix-panel">
    <h2 class="helix-section-title">Add product</h2>
    <div class="helix-form-grid">
        <CbTextInput Label="Name" @bind-Value="_newName" Placeholder="Product name" />
        <CbNumberInput Label="Price" @bind-Value="_newPrice" Placeholder="0.00" />
        <div class="helix-form-grid__full">
            <CbTextInput Label="Description" @bind-Value="_newDescription" Placeholder="Optional description" />
        </div>
    </div>
    <div class="helix-form-actions">
        <CbButton OnClick="CreateAsync">Add product</CbButton>
    </div>
</section>

<section class="helix-section helix-data-table">
    @if (_loading)
    {
        <CbInlineLoading Description="Loading products..." />
    }
    else
    {
        <CbDataTable TItem="ProductDto"
                     Title="Tenant products"
                     Items="_products"
                     Columns="_columns" />
    }
</section>

@code {
    private bool _loading = true;
    private List<ProductDto> _products = [];
    private string _newName = string.Empty;
    private string? _newDescription;
    private double? _newPrice;

    private List<CbDataTableColumn<ProductDto>> _columns = [];

    protected override void OnInitialized()
    {
        _columns =
        [
            new() { Header = "Name", Text = p => p.Name, Width = "16rem" },
            new() { Header = "Price", Text = p => p.Price.ToString("C"), Width = "8rem" },
            new() { Header = "Description", Text = p => p.Description ?? "-" }
        ];
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _products = (await Api.GetProductsAsync() ?? []).ToList();
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        var price = (decimal)(_newPrice ?? 0);
        await Api.CreateProductAsync(new CreateProductRequest(_newName, _newDescription, price));
        _newName = string.Empty;
        _newDescription = null;
        _newPrice = null;
        await ReloadAsync();
    }
}
