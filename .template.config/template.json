{
  "$schema": "http://json.schemastore.org/template",
  "author": "Portal.bh",
  "classifications": [ "Web", "Blazor", "Web API", "SaaS", "Multi-Tenant", "Cloud" ],
  "name": "HelixCarbon T3 SaaS",
  "description": "Multi-tenant Blazor WebAssembly SaaS with IBM Carbon UI, Dapper, Minimal APIs, ApexCharts, and configurable database and authentication.",
  "identity": "PortalBH.HelixCarbon.SaaS",
  "shortName": "myt3-carbon-saas",
  "defaultName": "HelixCarbon",
  "tags": {
    "language": "C#",
    "type": "solution",
    "editorTreatAs": "solution",
    "vs_showParametersByDefault": "true"
  },
  "sourceName": "HelixCarbon",
  "preferNameDirectory": true,
  "primaryOutputs": [
    { "path": "HelixCarbon.app.slnx" },
    { "path": "HelixCarbon.app.slnLaunch" },
    { "path": "src/HelixCarbon.Shared/HelixCarbon.Shared.csproj" },
    { "path": "src/HelixCarbon.Client/HelixCarbon.Client.csproj" },
    { "path": "src/HelixCarbon.Server/HelixCarbon.Server.csproj" },
    { "path": "lib/CarbonBlazor/CarbonBlazor.csproj" }
  ],
  "postActions": [
    {
      "condition": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")",
      "description": "Restore NuGet packages required by the solution.",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA902F",
      "continueOnError": true
    }
  ],
  "symbols": {
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "authMode": {
      "type": "parameter",
      "description": "Authentication for the API and UI.",
      "datatype": "choice",
      "defaultValue": "BFF",
      "displayName": "Authentication",
      "choices": [
        {
          "choice": "None",
          "description": "Open APIs; no login UI (use X-Tenant header).",
          "displayName": "None (development)"
        },
        {
          "choice": "BFF",
          "description": "Cookie-based auth on the same origin (recommended for Blazor).",
          "displayName": "BFF (cookie, recommended)"
        },
        {
          "choice": "Advanced",
          "description": "Cookie auth with Dapper-backed users per tenant.",
          "displayName": "Advanced (cookie + Dapper users)"
        },
        {
          "choice": "Azure",
          "description": "Microsoft Entra ID (MSAL) + JWT bearer API.",
          "displayName": "Microsoft Entra ID (Azure AD)"
        }
      ]
    },
    "database": {
      "type": "parameter",
      "description": "Database provider and default connection strings in appsettings.",
      "datatype": "choice",
      "defaultValue": "Sqlite",
      "displayName": "Database",
      "replaces": "__DATABASE_PROVIDER__",
      "choices": [
        {
          "choice": "Sqlite",
          "description": "File-based SQLite (ideal for local development).",
          "displayName": "SQLite (development)"
        },
        {
          "choice": "Postgres",
          "description": "PostgreSQL (typical for production).",
          "displayName": "PostgreSQL (production)"
        }
      ]
    },
    "seedDemoData": {
      "type": "parameter",
      "description": "Create a demo tenant, sample products, and admin user when running in Development.",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Seed demo data",
      "replaces": "HelixCarbon_SeedDemoData"
    },
    "defaultTenant": {
      "type": "parameter",
      "description": "Default X-Tenant slug used by the Blazor client for local development.",
      "datatype": "string",
      "defaultValue": "demo",
      "displayName": "Default tenant slug",
      "replaces": "__DEFAULT_TENANT_SLUG__"
    },
    "useHttps": {
      "type": "parameter",
      "description": "Application URL scheme in launchSettings.",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Enable HTTPS"
    },
    "AuthNone": { "type": "computed", "value": "(authMode == None)" },
    "AuthAzure": { "type": "computed", "value": "(authMode == Azure)" },
    "AuthBFF": { "type": "computed", "value": "(authMode == BFF)" },
    "AuthAdvanced": { "type": "computed", "value": "(authMode == Advanced)" },
    "DB_Sqlite": { "type": "computed", "value": "(database == Sqlite)" },
    "DB_Postgres": { "type": "computed", "value": "(database == Postgres)" },
    "SeedDemoData": { "type": "computed", "value": "(seedDemoData == true)" },
    "UseHttps": { "type": "computed", "value": "(useHttps == true)" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "_testgen/**",
        "artifacts/**",
        "build/**",
        "_ref/**",
        "_carbon_tmp/**",
        "**/bin/**",
        "**/obj/**",
        ".git/**",
        ".cursor/**",
        "**/*.plan.md",
        "HelixCarbon.TemplatePack.csproj",
        "LocalBuild.props",
        "**/Properties/launchSettings.json"
      ],
      "modifiers": [
        {
          "condition": "(authMode != Azure)",
          "exclude": [ "**/Features/Auth/AzureLoginPage.razor" ]
        },
        {
          "condition": "(authMode == Azure)",
          "exclude": [
            "**/Features/Auth/LoginPage.razor",
            "**/Features/Auth/RegisterPage.razor",
            "**/Features/Auth/ProfilePage.razor"
          ]
        },
        {
          "condition": "(authMode == None)",
          "exclude": [
            "**/Features/Auth/LoginPage.razor",
            "**/Features/Auth/RegisterPage.razor",
            "**/Features/Auth/ProfilePage.razor",
            "**/Features/Auth/AzureLoginPage.razor"
          ]
        },
        {
          "condition": "(database == Sqlite)",
          "exclude": [ "**/Data/Seed.Postgres.sql" ]
        },
        {
          "condition": "(database == Postgres)",
          "exclude": [ "**/Data/Seed.sql" ]
        },
        {
          "condition": "(UseHttps)",
          "rename": {
            "src/HelixCarbon.Server/Properties/launchSettings.https.json": "src/HelixCarbon.Server/Properties/launchSettings.json"
          },
          "exclude": [
            "**/Properties/launchSettings.http.json"
          ]
        },
        {
          "condition": "(!UseHttps)",
          "rename": {
            "src/HelixCarbon.Server/Properties/launchSettings.http.json": "src/HelixCarbon.Server/Properties/launchSettings.json"
          },
          "exclude": [
            "**/Properties/launchSettings.https.json"
          ]
        },
        {
          "condition": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")",
          "rename": {
            "HelixCarbon.app.slnx": "HelixCarbon.slnx",
            "HelixCarbon.app.slnLaunch": "HelixCarbon.slnLaunch"
          }
        }
      ]
    }
  ]
}
